# ── Copy this file to .env and fill in your keys ─────────────────────────────
# LLM provider (pick ONE model string; format = "provider:model")
#   openai:gpt-4o-mini | anthropic:claude-sonnet-4-5 | openai:gpt-4o
#   free options: google_genai:gemini-3.6-flash (GOOGLE_API_KEY) | groq:llama-3.3-70b-versatile (GROQ_API_KEY)
LLM_MODEL=openai:gpt-4o-mini
# Optional backups, tried in order when the main model fails (e.g. free daily quota used up)
LLM_FALLBACKS=
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Live web verification (free tier: https://tavily.com)
TAVILY_API_KEY=tvly-...

# Vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_docs

# LangSmith observability (https://smith.langchain.com — optional but recommended)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=knowledge-network

# PDF parsing strategy: fast (quick start) | hi_res (best tables, heavier deps)
PDF_STRATEGY=fast

# Self-RAG loop
MAX_REVISIONS=2
